# Local development environment (legacy Express server path: `npm run dev`).
# Production Worker config lives in worker/wrangler.toml + Cloudflare secrets.

# OPENAI_API_KEY: required by the AI roster/event parsing endpoints.
# Any OpenAI-compatible provider works (OpenAI, MiniMax, Groq, OpenRouter, Together, Ollama, v.v.).
OPENAI_API_KEY="MY_OPENAI_API_KEY"

# OPENAI_MODEL: model id to use.
# Examples: MiniMax-M3, gpt-4o-mini, llama3.1:8b-instruct (Ollama).
OPENAI_MODEL="MiniMax-M3"

# OPENAI_BASE_URL: optional. Override to point to any OpenAI-compatible endpoint.
# Leave commented for OpenAI Cloud (https://api.openai.com/v1).
# MiniMax:    https://api.minimax.io/v1
# Ollama:     http://localhost:11434/v1
# OPENAI_BASE_URL="https://api.minimax.io/v1"

# APP_URL: where the app is hosted (self-referential links, OAuth callbacks).
APP_URL="http://localhost:3000"

# VITE_API_BASE: API base used by the frontend.
# Local dev (wrangler): http://localhost:8787
# Production: same-origin (relative /api via the Worker route on gametuoitho.space)
VITE_API_BASE=http://localhost:8787

# DB_FILE: path to the SQLite file for the legacy Express server (npm run dev).
# Default: database.db in the project root.
# DB_FILE=./database.db

# DB_FILE_JSON: path to the legacy seed JSON used on first boot when the DB is empty.
# Default: database.json in the project root.
# DB_FILE_JSON=./database.json
