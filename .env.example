# OPENAI_API_KEY: Required for AI roster parsing endpoint.
# Any OpenAI-compatible provider works (OpenAI, Groq, Together, OpenRouter, Mistral, local Ollama, v.v.).
# Configure via the Secrets panel in the AI Studio UI.
OPENAI_API_KEY="MY_OPENAI_API_KEY"

# OPENAI_MODEL: Model id to use. Must be set explicitly (server refuses to start parsing without it).
# Examples: gpt-4o-mini, gpt-4o, llama3.1:8b-instruct (Ollama).
OPENAI_MODEL="gpt-4o-mini"

# OPENAI_BASE_URL: Optional. Override to point to any OpenAI-compatible endpoint.
# Leave commented for OpenAI Cloud (https://api.openai.com/v1).
# For Ollama use:  http://localhost:11434/v1
# OPENAI_BASE_URL="http://localhost:11434/v1"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Two-process runtime: Next.js web + standalone Bun WS service.
PORT_WEB=3000
PORT_WS=3001
# Shared secret between ws-service and /api/internal/verify-user.
WS_INTERNAL_SECRET=change-me-to-random
# Where ws-service calls back to validate a connecting userId (HTTP, not WS).
WEB_INTERNAL_URL=http://localhost:3000
# Public URL the browser uses to open the WS connection.
NEXT_PUBLIC_WS_URL=ws://localhost:3001/ws
