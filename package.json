{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:fe": "vite build",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist database.json",
    "lint": "tsc --noEmit",
    "test": "vitest run --coverage && npm run test:co-tuong",
    "test:fast": "vitest run",
    "test:co-tuong": "tsx tests/coTuongCheck.test.ts",
    "dev:worker": "concurrently -k -n vite,worker -c blue,green \"vite\" \"cd worker && npx wrangler dev --local --port 8787\"",
    "deploy:worker": "cd worker && npx wrangler deploy",
    "db:migrate:local": "cd worker && npx wrangler d1 migrations apply gametuoitho-db --local",
    "db:migrate:remote": "cd worker && npx wrangler d1 migrations apply gametuoitho-db --remote",
    "test:worker": "cd worker && npm test",
    "dev:telegram": "tsx worker/scripts/telegram-preview.ts",
    "test:telegram": "npm --prefix worker test -- test/telegram-domain.test.ts test/telegram-actions.test.ts test/telegram-flow.test.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "openai": "^6.45.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.3",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^2.1.9"
  }
}
