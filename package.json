{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,ws \"PORT_WEB=${PORT_WEB:-3000} bunx next dev\" \"bun run dev:ws\"",
    "dev:legacy": "tsx server.ts",
    "dev:ws": "tsx --watch ws-service/index.ts",
    "build:ws": "bun build ws-service/index.ts --target=bun --outdir=dist/ws",
    "start:ws": "bun dist/ws/index.js",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist database.json",
    "lint": "tsc --noEmit"
  },
  "engines": {
    "bun": ">=1.1.42"
  },
  "packageManager": "bun@1.1.42",
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "next": "15",
    "openai": "^6.45.0",
    "react": "19",
    "react-dom": "19",
    "vite": "^6.2.3",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.21",
    "@types/node": "^26.1.0",
    "@types/react": "19",
    "@types/react-dom": "19",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.3",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vite": "^6.2.3"
  }
}
